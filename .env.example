# ---------------------------------------------------------------------------
# Line-Up — root environment reference
#
# Each application reads its OWN env file. This file only documents which
# variables exist and where they belong. Copy the per-app examples:
#
#   frontend/.env.example  ->  frontend/.env.local
#   backend/.env.example   ->  backend/.env
#
# Never commit real values. Only *.example files are tracked by Git.
# ---------------------------------------------------------------------------

# --- backend (backend/.env) ---
# NODE_ENV=development
# PORT=4000
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/lineup?schema=public
# CORS_ORIGIN=http://localhost:3000

# --- frontend (frontend/.env.local) ---
# NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
