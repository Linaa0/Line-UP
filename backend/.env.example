# Line-Up backend environment
# Copy to .env and fill in real values. Never commit .env.
# Validated at startup by src/config/env.validation.ts.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string
# postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/lineup?schema=public

# SSL for the database connection: false (local database), true (certificate
# checked) or no-verify (encrypted, certificate not checked; e.g. Render)
DATABASE_SSL=false

# Comma-separated list of origins allowed to call the API
CORS_ORIGIN=http://localhost:3003

# Secret used to sign login tokens. Use a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
JWT_EXPIRES_IN_DAYS=30

# No SMS provider is connected yet. When true, the API returns the OTP code in
# its response and the app shows it as a demo code. Set false in production
# once real SMS delivery exists.
OTP_DEMO_MODE=true
