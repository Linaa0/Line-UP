# Line-Up mobile environment. Copy to .env.local (git-ignored).
# EXPO_PUBLIC_ variables are bundled into the app — never put secrets here.

# Backend API base URL.
# Leave it unset during development: the app uses the computer that runs Expo
# (its current Wi-Fi address) automatically, on phones, emulators and the web.
# Set it only to use a fixed server, e.g. the hosted API:
# EXPO_PUBLIC_API_URL=https://your-hosted-api.example/api/v1
