# Line-Up mobile environment. Copy to .env.local (git-ignored).
# EXPO_PUBLIC_ variables are bundled into the app — never put secrets here.

# Backend API base URL.
# - Android emulator: http://10.0.2.2:4000/api/v1
# - iOS simulator / web: http://localhost:4000/api/v1
# - Physical phone (Expo Go): http://<your-computer-LAN-IP>:4000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
